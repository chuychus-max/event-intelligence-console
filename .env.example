# Todas son opcionales: sin ninguna, la consola corre con el simulador y memoria.

# Llave para enviar datos reales a POST /api/ingest (header x-api-key). Sin ella, la ingesta está apagada.
INGEST_API_KEY=

# Contraseña de la consola (Basic Auth; cualquier usuario). Sin ella, la consola es pública.
CONSOLE_PASSWORD=

# Copiloto con Claude para preguntas libres. Sin ella, responde por reglas.
ANTHROPIC_API_KEY=

# Persistencia compartida: Upstash Redis (Vercel Marketplace las crea solas).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# o bien
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
